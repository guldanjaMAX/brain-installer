node_modules/
.env
.env.*
*.log
.DS_Store

# Filled manifests carry a client's account id and their brain's hostname.
# The template is tracked; real ones are not.
manifests/
*.manifest.local.json
instances/*.manifest.json

# Real evaluation sets and baselines contain client-sensitive questions and
# facts. The package ships only the blank template; filled sets stay local.
eval/golden/*
!eval/golden/TEMPLATE.golden.json
eval/baselines/
# The shipped evaluator creates this beside each manifest. It contains the
# owner's real questions, expected claims, and source identities.
brain.golden.json

# A real eval config names a real brain's hostname and how its admin key is
# looked up. No secret value, but it is a targeting aid in a public repo, so the
# tracked file is a template and the real one stays local.
eval/eval.config.local.json

# Temporary migration receipts name private source ids and the isolated target.
# They contain no credentials, but they are operational state rather than code.
.brain-migration-*.json
.brain-migration-*.json.tmp-*

# Connector cursors and folder indexes contain private source IDs. They are
# machine-local operational state and must never become a tracked artifact.
.brain-ingest-*.json
.brain-ingest-*.json.tmp-*

# Exact curated inventories, target locators and coverage receipts are private
# instance state. Only the generic operation that reads them is product source.
.brain-curated-sync-*.json
.brain-curated-sync-*.json.tmp-*

# Verified-recovery control files and D1 SQL exports are private instance state.
# The SQL artifact contains the full durable corpus and is never support data.
.brain-recovery-*.json
.brain-recovery-*.json.tmp-*
.brain-recovery-*.sql
.brain-recovery-*.sql.tmp-*

# Adjacent fallback admin-key files contain the Brain's live authentication
# secret. Atomic writes briefly create the matching residue beside them.
.brain-admin-key
.brain-admin-key.tmp-*

# Live Drive lifecycle receipts contain the private remote file id. The eight
# character classes intentionally match only the harness's validated hex id.
.brain-drive-live-fixture-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
.brain-drive-live-fixture-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json.tmp-*

# User-reviewed exports of the private local installer issue journal.
brain-support-*.jsonl
support-bundle*.json
docs/*-readiness-*.md
